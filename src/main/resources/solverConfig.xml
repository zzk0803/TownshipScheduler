<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://timefold.ai/xsd/solver"
        xsi:schemaLocation="https://timefold.ai/xsd/solver https://timefold.ai/xsd/solver/solver.xsd"
>
    <enablePreviewFeature>DIVERSIFIED_LATE_ACCEPTANCE</enablePreviewFeature>

    <environmentMode>PHASE_ASSERT</environmentMode>

    <solutionClass>zzk.townshipscheduler.backend.scheduling.model.TownshipSchedulingProblem</solutionClass>
    <entityClass>
        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
    </entityClass>
    <entityClass>
        zzk.townshipscheduler.backend.scheduling.model.SchedulingFactoryInstance
    </entityClass>
    <entityClass>
        zzk.townshipscheduler.backend.scheduling.model.SchedulingDateTimeSlot
    </entityClass>
    <entityClass>
        zzk.townshipscheduler.backend.scheduling.model.SchedulingPlayer
    </entityClass>


    <scoreDirectorFactory>
        <constraintProviderClass>
            zzk.townshipscheduler.backend.scheduling.score.TownshipSchedulingConstraintProvider
        </constraintProviderClass>
        <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>
    </scoreDirectorFactory>

    <!--region constructionHeuristic-->
    <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT</constructionHeuristicType>
        <valueSorterManner>ASCENDING</valueSorterManner>
        <changeMoveSelector>
            <valueSelector variableName="planningFactoryInstance"
                           id="constructionHeuristic_changeMoveSelector_vs_Arrangement_planningFactory">
            </valueSelector>
        </changeMoveSelector>
        <changeMoveSelector>
            <filterClass>
                zzk.townshipscheduler.backend.scheduling.algorithm.ProducingArrangementPlanningFactoryConstructionHeuristicChangeMoveSelectionFilter
            </filterClass>
            <valueSelector variableName="planningDateTimeSlot"
                           id="constructionHeuristic_changeMoveSelector_vs_Arrangement_planningDateTimeSlot">
            </valueSelector>
        </changeMoveSelector>
    </constructionHeuristic>
    <!--endregion-->

    <!--region init-->
    <!--    <customPhase>-->
    <!--        <customPhaseCommandClass>-->
    <!--            zzk.townshipscheduler.backend.scheduling.algorithm.TownshipInitiateCustomPhase-->
    <!--        </customPhaseCommandClass>-->
    <!--    </customPhase>-->
    <!--    endregion-->

    <!--region local search-->

    <localSearch>
        <termination>
            <unimprovedSecondsSpentLimit>10</unimprovedSecondsSpentLimit>
        </termination>

        <unionMoveSelector>
            <changeMoveSelector>
                <entitySelector id="localSearch_changeMoveSelector_es_Arrangement_planningFactory">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.schedulingProducingArrangementFactoryValueRangesFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningFactoryInstance"
                               id="localSearch_changeMoveSelector_vs_Arrangement_planningFactory">
                </valueSelector>
            </changeMoveSelector>

            <pillarChangeMoveSelector>
                <pillarSelector>
                    <entitySelector id="localSearch_pillarChangeMoveSelector_es_Arrangement_planningFactoryInstance">
                        <entityClass>
                            zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                        </entityClass>
                        <filterClass>
                            zzk.townshipscheduler.backend.scheduling.algorithm.schedulingProducingArrangementFactoryValueRangesFilter
                        </filterClass>
                    </entitySelector>
                </pillarSelector>
                <valueSelector variableName="planningFactoryInstance"
                               id="localSearch_pillarChangeMoveSelector_vs_Arrangement_planningFactoryInstance"/>
            </pillarChangeMoveSelector>
        </unionMoveSelector>
    </localSearch>

    <localSearch>

        <termination>
            <unimprovedSecondsSpentLimit>30</unimprovedSecondsSpentLimit>
        </termination>

        <unionMoveSelector>

            <changeMoveSelector>
                <entitySelector id="localSearch_changeMoveSelector_es_Arrangement_planningFactory">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.schedulingProducingArrangementFactoryValueRangesFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningFactoryInstance"
                               id="localSearch_changeMoveSelector_vs_Arrangement_planningFactory">
                </valueSelector>
            </changeMoveSelector>

            <pillarChangeMoveSelector>
                <pillarSelector>
                    <entitySelector id="localSearch_pillarChangeMoveSelector_es_Arrangement_planningFactoryInstance">
                        <entityClass>
                            zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                        </entityClass>
                        <filterClass>
                            zzk.townshipscheduler.backend.scheduling.algorithm.schedulingProducingArrangementFactoryValueRangesFilter
                        </filterClass>
                    </entitySelector>
                </pillarSelector>
                <valueSelector variableName="planningFactoryInstance"
                               id="localSearch_pillarChangeMoveSelector_vs_Arrangement_planningFactoryInstance"/>
            </pillarChangeMoveSelector>

            <changeMoveSelector>
                <entitySelector id="localSearch_changeMoveSelector_es_Arrangement_planningDateTimeSlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                </entitySelector>
                <valueSelector variableName="planningDateTimeSlot"
                               id="localSearch_changeMoveSelector_vs_Arrangement_planningDateTimeSlot">
                </valueSelector>
            </changeMoveSelector>

            <swapMoveSelector>
                <entitySelector id="localSearch_swapMoveSelector_es_Arrangement_planningDateTimeSlot_p">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                </entitySelector>
                <secondaryEntitySelector id="localSearch_swapMoveSelector_es_Arrangement_planningDateTimeSlot_q">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                </secondaryEntitySelector>
                <variableNameIncludes>
                    <variableNameInclude>planningDateTimeSlot</variableNameInclude>
                </variableNameIncludes>
            </swapMoveSelector>

            <pillarChangeMoveSelector>
                <pillarSelector>
                    <entitySelector id="localSearch_pillarChangeMoveSelector_es_Arrangement_planningDateTimeSlot">
                        <entityClass>
                            zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                        </entityClass>
                    </entitySelector>
                </pillarSelector>
                <valueSelector variableName="planningDateTimeSlot"
                               id="localSearch_pillarChangeMoveSelector_vs_Arrangement_planningDateTimeSlot"/>
            </pillarChangeMoveSelector>

            <pillarSwapMoveSelector>
                <pillarSelector>
                    <entitySelector id="localSearch_pillarSwapMoveSelector_es_Arrangement_planningDateTimeSlot_p">
                        <entityClass>
                            zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                        </entityClass>
                    </entitySelector>
                </pillarSelector>
                <secondaryPillarSelector>
                    <entitySelector id="localSearch_pillarSwapMoveSelector_es_Arrangement_planningDateTimeSlot_q">
                        <entityClass>
                            zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                        </entityClass>
                    </entitySelector>
                </secondaryPillarSelector>
                <variableNameIncludes>
                    <variableNameInclude>planningDateTimeSlot</variableNameInclude>
                </variableNameIncludes>
            </pillarSwapMoveSelector>

        </unionMoveSelector>

        <acceptor>
            <lateAcceptanceSize>20</lateAcceptanceSize>
        </acceptor>

        <forager>
            <acceptedCountLimit>2</acceptedCountLimit>
        </forager>

    </localSearch>
    <!--endregion-->

</solver>
