    <!--region local search-->
    <localSearch>

        <termination>
            <diminishedReturns>
                <slidingWindowSeconds>30</slidingWindowSeconds>
                <minimumImprovementRatio>0.01</minimumImprovementRatio>
            </diminishedReturns>
        </termination>


        <unionMoveSelector>

            <changeMoveSelector>
                <entitySelector id="localSearch_changeMoveSelector(slot)_es_Arrangement_planningDelaySlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.ChangeMoveProducingArrangementEntitySlotTypeFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningDelaySlot"
                               id="localSearch_changeMoveSelector(slot)_vs_Arrangement_planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>

            <changeMoveSelector>
                <entitySelector id="localSearch_listChangeMoveSelector_changeMoveSelector(queue)_es_Arrangement_planningDelaySlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.ChangeMoveProducingArrangementEntityQueueTypeFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningDelaySlot"
                               id="localSearch_listChangeMoveSelector_changeMoveSelector(queue)_vs_Arrangement_planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>

            <listChangeMoveSelector>
                <filterClass>zzk.townshipscheduler.backend.scheduling.algorithm.ProducingArrangementListChangeMoveFilter</filterClass>
                <valueSelector>
                    <filterClass>zzk.townshipscheduler.backend.scheduling.algorithm.ProducingArrangementListChangeValueFilter</filterClass>
                </valueSelector>
            </listChangeMoveSelector>

            <listSwapMoveSelector/>
            <!--            <subListChangeMoveSelector>-->
            <!--                <selectReversingMoveToo>true</selectReversingMoveToo>-->
            <!--            </subListChangeMoveSelector>-->
            <!--            <subListSwapMoveSelector>-->
            <!--                <selectReversingMoveToo>true</selectReversingMoveToo>-->
            <!--            </subListSwapMoveSelector>-->
            <kOptListMoveSelector/>

        </unionMoveSelector>

        <acceptor>
            <lateAcceptanceSize>29</lateAcceptanceSize>
        </acceptor>

        <forager>
            <acceptedCountLimit>3</acceptedCountLimit>
        </forager>

    </localSearch>
    <!--endregion-->

