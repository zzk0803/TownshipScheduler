    <!--region local search-->
    <localSearch>

        <termination>
            <diminishedReturns>
                <slidingWindowMinutes>1</slidingWindowMinutes>
                <minimumImprovementRatio>0.125</minimumImprovementRatio>
            </diminishedReturns>
        </termination>

        <unionMoveSelector>

            <listChangeMoveSelector/>
            <listSwapMoveSelector/>
            <subListChangeMoveSelector/>
            <subListSwapMoveSelector/>

            <changeMoveSelector>
                <fixedProbabilityWeight>3</fixedProbabilityWeight>
                <entitySelector id="localSearch_changeMoveSelector_es_Arrangement_planningDelaySlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                </entitySelector>
                <valueSelector variableName="planningDelaySlot"
                               id="localSearch_changeMoveSelector_vs_Arrangement_planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>

        </unionMoveSelector>

        <acceptor>
            <entityTabuRatio>0.125</entityTabuRatio>
            <stepCountingHillClimbingSize>375</stepCountingHillClimbingSize>
            <stepCountingHillClimbingType>ACCEPTED_MOVE</stepCountingHillClimbingType>
        </acceptor>

        <forager>
            <acceptedCountLimit>2</acceptedCountLimit>
        </forager>

    </localSearch>
