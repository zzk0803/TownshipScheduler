    <!--region local search-->
    <localSearch>

        <termination>
            <diminishedReturns>
                <slidingWindowMinutes>1</slidingWindowMinutes>
                <minimumImprovementRatio>0.02</minimumImprovementRatio>
            </diminishedReturns>
        </termination>

        <unionMoveSelector>

            <listChangeMoveSelector/>
            <listSwapMoveSelector/>
            <subListChangeMoveSelector/>
            <subListSwapMoveSelector/>
            <kOptListMoveSelector/>

            <changeMoveSelector>
                <fixedProbabilityWeight>3</fixedProbabilityWeight>
                <entitySelector id="localSearch_changeMoveSelector(queue)_es_Arrangement_planningDelaySlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.ChangeMoveProducingArrangementEntityQueueTypeFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningDelaySlot"
                               id="localSearch_changeMoveSelector(queue)_vs_Arrangement_planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>

            <changeMoveSelector>
                <entitySelector id="localSearch_changeMoveSelector(slot)_es_Arrangement_planningDelaySlot">
                    <entityClass>
                        zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement
                    </entityClass>
                    <filterClass>
                        zzk.townshipscheduler.backend.scheduling.algorithm.ChangeMoveProducingArrangementEntitySlotTypeFilter
                    </filterClass>
                </entitySelector>
                <valueSelector variableName="planningDelaySlot"
                               id="localSearch_changeMoveSelector(slot)_vs_Arrangement_planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>

        </unionMoveSelector>

        <acceptor>
            <lateAcceptanceSize>11</lateAcceptanceSize>
        </acceptor>

        <forager>
            <acceptedCountLimit>2</acceptedCountLimit>
        </forager>

    </localSearch>
    <!--endregion-->

</solver>
