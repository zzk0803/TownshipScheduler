    <!--region constructionHeuristic::double constructionHeuristic-->
    <constructionHeuristic>
        <queuedEntityPlacer>
            <entitySelector id="constructionHeuristic2_entitySelector_SchedulingProducingArrangement">
                <entityClass>zzk.townshipscheduler.backend.scheduling.model.SchedulingProducingArrangement</entityClass>
                <cacheType>PHASE</cacheType>
                <selectionOrder>SORTED</selectionOrder>
            </entitySelector>

            <changeMoveSelector>
                <entitySelector mimicSelectorRef="constructionHeuristic2_entitySelector_SchedulingProducingArrangement"/>
                <valueSelector id="constructionHeuristic2_changeMoveSelector_assignedTools"
                               variableName="planningDelaySlot">
                </valueSelector>
            </changeMoveSelector>
        </queuedEntityPlacer>
    </constructionHeuristic>

    <constructionHeuristic>

        <termination>
            <secondsSpentLimit>90</secondsSpentLimit>
        </termination>

        <queuedValuePlacer>
            <entityClass>zzk.townshipscheduler.backend.scheduling.model.SchedulingFactoryInstance</entityClass>
            <valueSelector id="constructionHeuristic1_valueSelector_arrangements" variableName="planningArrangementsSequence">
                <cacheType>PHASE</cacheType>
                <selectionOrder>SORTED</selectionOrder>
                <comparatorClass>
                    zzk.townshipscheduler.backend.scheduling.model.utility.SchedulingProducingArrangementDifficultyComparator
                </comparatorClass>
                <sorterOrder>ASCENDING</sorterOrder>
            </valueSelector>
            <unionMoveSelector>
                <listChangeMoveSelector>
                    <valueSelector mimicSelectorRef="constructionHeuristic1_valueSelector_arrangements"/>
                    <destinationSelector>
                        <entitySelector>
                            <entityClass>zzk.townshipscheduler.backend.scheduling.model.SchedulingFactoryInstance</entityClass>
                        </entitySelector>
                        <valueSelector mimicSelectorRef="constructionHeuristic1_valueSelector_arrangements"/>
                    </destinationSelector>
                </listChangeMoveSelector>
            </unionMoveSelector>
        </queuedValuePlacer>

        <forager>
            <pickEarlyType>FIRST_FEASIBLE_SCORE_OR_NON_DETERIORATING_HARD</pickEarlyType>
        </forager>

    </constructionHeuristic>
    <!--endregion-->

    <!--endregion-->

    <!--region customPhase-->
