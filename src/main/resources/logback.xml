<configuration>
    <!-- 定义日志文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>township-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>scheduling-debug.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 控制台输出（可选，建议设为 INFO 避免刷屏） -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- 针对你的业务包开启 DEBUG 级别 -->
    <logger name="zzk.townshipscheduler" level="DEBUG"/>

    <!-- Timefold 求解器日志（可选，设为 INFO 或 WARN） -->
    <logger name="ai.timefold" level="INFO"/>
</configuration>
